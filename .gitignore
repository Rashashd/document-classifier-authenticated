# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg
*.egg
MANIFEST

# ----- PyInstaller -----
*.manifest
*.spec

# ----- uv / virtualenvs -----
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
.poetry/
.uv/

# ----- Test & coverage artefacts -----
.coverage
.coverage.*
htmlcov/
.htmlcov/
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.hypothesis/
coverage.xml
*.cover
nosetests.xml
.benchmarks/

# ----- Alembic -----
app/db/migrations/__pycache__/

# ----- IDE / editor -----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Project: secrets & local config -----
# `.env.example` IS tracked; the real `.env` (Vault root token, ports) is not.
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ----- Local SQLite (if anyone enables it for local debug) -----
*.db
*.sqlite
*.sqlite3

# ----- Docker / runtime data volumes -----
# Local volume mounts and runtime data must never enter the repo.
minio-data/
redis-data/
sftp-data/
postgres-data/
vault-data/
docker-data/
*.pid
docker-compose.override.yml

# ----- Classifier artefacts (committed via git LFS only) -----
*.pt
*.pth
*.pkl
*.h5
*.joblib
app/classifier/datasets/
app/classifier/checkpoints/
app/classifier/models/*.pt
!app/classifier/models/.gitattributes

# ----- TIFFs are never committed except for the golden set -----
*.tiff
*.tif
golden_images/
!app/classifier/eval/golden_images/
!app/classifier/eval/golden_images/*.tiff
!app/classifier/eval/golden_images/*.tif

# ----- Local override files -----
*.local.yaml
*.local.yml

# ----- Logs -----
*.log
# logs/ holds JSON test-run records (per-script subdirs, per-run files);
# we keep them in source so historical runs are reviewable.
!logs/

# ----- Node / frontend (until that team sets their own) -----
frontend/node_modules/
frontend/dist/
frontend/.next/

# ----- Misc local working folders -----
plan/
