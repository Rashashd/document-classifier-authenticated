# =============================================================================
# Document Classifier — environment variables
# Copy to .env and fill in all values before running `docker compose up`.
# .env is gitignored; .env.example is tracked.
# =============================================================================

# ---- Vault (required) -------------------------------------------------------
# Dev-mode root token. The hashicorp/vault container in compose boots in
# `-dev` mode and uses this value as the root token.
VAULT_TOKEN=dev-root-token-change-in-prod
# Override only when running app code OUTSIDE Docker. Inside compose,
# the api/worker containers set this to http://vault:8200 themselves.
# VAULT_ADDR=http://localhost:8200

# ---- Postgres (required, used by compose db service) -----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# ---- MinIO (required, used by compose minio service) -----------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-in-production

# ---- SFTP (required, used by compose sftp service) -------------------------
SFTP_USER=scanner
SFTP_PASSWORD=change-me-in-production

# ---- Application config (read by pydantic Settings + the worker) -----------
# Needed when running app code on the HOST (e.g. `uv run alembic upgrade head`,
# `uv run pytest`, ad-hoc scripts). Inside compose, the api/migrate/worker
# containers compute their own DATABASE_URL from POSTGRES_* and use the
# in-network host `db` (not localhost).
# Host port is 5433 because compose maps 5433:5432 to avoid clashing with a
# developer-local Postgres on 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/app

# ---- Redis (optional, has worker default) ----------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- JWT (optional, have defaults in Settings) -----------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Vault KV paths (optional — only override if you rename the secrets) ---
# VAULT_JWT_SECRET_PATH=secret/data/jwt
# VAULT_SFTP_PATH=sftp
# VAULT_MINIO_PATH=minio

# ---- Deployment env (gates dev-only routes; defaults to "development") -----
# Set APP_ENV=production in the prod deployment so /test/* endpoints are
# suppressed at mount time. Values: development | test | staging | production.
# APP_ENV=development
