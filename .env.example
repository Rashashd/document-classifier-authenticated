# =============================================================================
# Document Classifier — environment variables
# Copy to .env and fill in all values before running.
# Never commit .env — it is in .gitignore.
# =============================================================================

# Vault (required)
VAULT_TOKEN=password
# VAULT_ADDR=http://localhost:8200   # override when running outside Docker

# Postgres (required)
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=databasename

# MinIO (required)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-in-production

# SFTP (required)
SFTP_USER=scanner
SFTP_PASSWORD=change-me-in-production

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Vault KV paths (optional — only change if you rename the secrets)
# VAULT_JWT_SECRET_PATH=secret/data/jwt
# VAULT_SFTP_PATH=sftp
# VAULT_MINIO_PATH=minio